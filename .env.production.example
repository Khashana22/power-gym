# ─────────────────────────────────────────────────────────────────────────────
# Power Gym – Production Environment Template
# Copy to .env.production and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=power_gym
DB_HOST=postgres
DB_PORT=5432

# Full DATABASE_URL (used by Prisma inside containers)
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/power_gym

# ── Application ───────────────────────────────────────────────────────────────
# Your domain name (no trailing slash)
APP_URL=https://yourdomain.com

# JWT Secret – generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_RANDOM_64_BYTES_HEX

# ── WhatsApp Business API (Meta) ──────────────────────────────────────────────
# Get these from Meta Developer Console → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── S3 Backup (Optional) ──────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET=power-gym-backups

# ── Backup Retention ──────────────────────────────────────────────────────────
BACKUP_KEEP_COUNT=30
