generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  RECEPTION
  TRAINER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  FROZEN
}

enum PaymentMethod {
  CASH
  VISA
  INSTAPAY
  VODAFONE_CASH
}

enum NotificationType {
  WELCOME
  EXPIRY_REMINDER
  EXPIRED
  RENEWED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Gym {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  users     User[]
  members   Member[]
  plans     MembershipPlan[]
  expenses  Expense[]
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      UserRole

  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id])

  createdAt DateTime @default(now())
}

model Member {
  id           String   @id @default(cuid())
  memberCode   String   @unique   // PG-2026-000001
  fullName     String
  phone        String   @unique
  email        String?
  photo        String?
  qrToken      String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id])

  subscriptions Subscription[]
  attendance    Attendance[]
  notifications Notification[]

  @@index([fullName])
  @@index([phone])
}

model MembershipPlan {
  id            String   @id @default(cuid())
  name          String
  durationDays  Int
  price         Float
  isActive      Boolean  @default(true)

  gymId         String
  gym           Gym      @relation(fields: [gymId], references: [id])

  subscriptions Subscription[]
}

model Subscription {
  id          String              @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  status      SubscriptionStatus  @default(ACTIVE)

  memberId    String
  member      Member              @relation(fields: [memberId], references: [id])

  planId      String
  plan        MembershipPlan      @relation(fields: [planId], references: [id])

  payments    Payment[]

  createdAt   DateTime            @default(now())

  @@index([endDate])
}

model Payment {
  id             String        @id @default(cuid())
  amount         Float
  method         PaymentMethod
  paidAt         DateTime      @default(now())

  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
}

model Attendance {
  id        String   @id @default(cuid())
  checkIn   DateTime @default(now())

  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])

  @@index([checkIn])
}

model Notification {
  id        String              @id @default(cuid())
  type      NotificationType
  message   String
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  memberId  String
  member    Member              @relation(fields: [memberId], references: [id])
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  category  String
  amount    Float
  createdAt DateTime @default(now())

  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id])
}